# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=devpractice_super_secret_jwt_key_hackathon_2026_secured

# ---------------------------------------------------------------------------
# 1. Google OAuth Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 2. GitHub OAuth Credentials
# Obtain from: https://github.com/settings/developers -> OAuth Apps
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
# ---------------------------------------------------------------------------
GITHUB_ID=
GITHUB_SECRET=

# ---------------------------------------------------------------------------
# 3. Microsoft Azure AD / Entra ID Credentials
# Obtain from: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Redirect URI: http://localhost:3000/api/auth/callback/azure-ad
# ---------------------------------------------------------------------------
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
